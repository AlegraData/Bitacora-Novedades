generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  image     String?
  role      Role       @default(VIEWER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

model Field {
  id           String            @id @default(cuid())
  name         String
  type         String
  order        Int               @default(0)
  isFilterable Boolean           @default(true)
  isVisible    Boolean           @default(true)
  config       Json?
  options      Tag[]
  permissions  FieldPermission[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Tag {
  id      String @id @default(cuid())
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  name    String
  color   String @default("#e2e8f0")
  order   Int    @default(0)
}

model Record {
  id             String           @id @default(cuid())
  data           Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdByEmail String
  createdByName  String
  embedding      RecordEmbedding?
}

model RecordEmbedding {
  id        String                 @id @default(cuid())
  recordId  String                 @unique
  record    Record                 @relation(fields: [recordId], references: [id], onDelete: Cascade)
  content   String // Texto plano del que se generó el embedding
  embedding Unsupported("vector")? // Vector generado (768 para Gemini)
}

model FieldPermission {
  id      String  @id @default(cuid())
  fieldId String
  field   Field   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  role    Role
  canEdit Boolean @default(true)

  @@unique([fieldId, role])
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  userName  String
  action    String
  recordId  String?
  details   Json?
}

model View {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("📋")
  filters   Json     @default("{}")
  sort      Json?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  @@index([clientId])
}

model OAuthCode {
  id            String   @id @default(cuid())
  code          String   @unique
  userEmail     String
  clientId      String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([code])
}

model OAuthSession {
  id               String    @id @default(cuid())
  accessToken      String    @unique
  refreshToken     String    @unique
  userEmail        String
  clientId         String
  clientName       String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([accessToken])
  @@index([refreshToken])
  @@index([userEmail])
}

// Tokens de acceso a la API REST (/api/v1). Del token solo se guarda el hash
// SHA-256; el valor en claro se muestra una única vez al crearlo.
model ApiKey {
  id                String          @id @default(cuid())
  name              String
  description       String?
  prefix            String // Primeros caracteres visibles para identificarlo en listados
  keyHash           String          @unique
  scopes            String[]
  ownerEmail        String // La key actúa con el rol vigente de este usuario
  expiresAt         DateTime
  lastUsedAt        DateTime?
  lastUsedIp        String?
  lastUsedUserAgent String?
  useCount          Int             @default(0)
  revokedAt         DateTime?
  revokedByEmail    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  requests          ApiRequestLog[]

  @@index([ownerEmail])
}

// Una fila por request autenticado con token (incluye rechazos 403/429) para
// poder ver cómo se está consumiendo cada key.
model ApiRequestLog {
  id         String   @id @default(cuid())
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  method     String
  path       String
  status     Int
  ip         String?
  userAgent  String?
  durationMs Int

  @@index([apiKeyId, timestamp])
}

// Configuración global del envío de correos (una sola fila).
model EmailSettings {
  id             String   @id @default("singleton")
  // webhook = Apps Script legado | shadow = legado envía + la app simula | test = SMTP solo a testRecipients | live = SMTP real
  mode           String   @default("webhook")
  fromName       String   @default("Alegra Product News")
  replyTo        String?
  testRecipients String[]
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

// Plantilla activa del correo (Handlebars). Cada guardado deja una revisión.
model EmailTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  subject        String
  html           String
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

model EmailTemplateRevision {
  id           String   @id @default(cuid())
  templateKey  String
  version      Int
  subject      String
  html         String
  savedByEmail String?
  createdAt    DateTime @default(now())

  @@index([templateKey, version])
}

// Un intento de envío (real, de prueba o simulado). `lockKey` es único mientras
// el envío está en curso o ya se completó: garantiza una sola comunicación por
// novedad aunque dos personas disparen a la vez. Se libera (null) si falla.
model EmailDelivery {
  id               String    @id @default(cuid())
  recordId         String?
  kind             String    @default("novedad")
  mode             String // webhook | shadow | test | live | simulate | legacy
  status           String // sending | sent | failed | simulated
  lockKey          String?   @unique
  subject          String?
  recipients       String[]
  rejected         String[]
  html             String?
  channel          String // web | mcp | api | admin
  trigger          String // auto | manual | button | test | simulate
  triggeredByEmail String
  triggeredByName  String?
  resendReason     String?
  errorCode        String?
  errorMessage     String?
  errorDetail      String?
  messageId        String?
  legacyResponse   String?
  chatStatus       String? // sent | failed
  chatError        String?
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?

  @@index([recordId, createdAt])
  @@index([status, createdAt])
}
